{
  "name": "@unb-libraries/vue-greyui",
  "description": "UI composable library for Vue 3",
  "author": {
    "name": "Patrick Schilf",
    "email": "pschilf@unb.ca"
  },
  "type": "module",
  "repository": "github:unb-libraries/vue-greyui",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && cp ./lib/shims-vue.d.ts ./dist/types/shims-vue.d.ts",
    "preview": "vite preview",
    "playground": "npm run dev --workspace=playground",
    "lint": "eslint .",
    "lint:inspect": "npx @eslint/config-inspector@latest",
    "lint:commit": "npx eslint $(find $(git diff --diff-filter=d --name-only --cached | xargs) -type f -name \"*.ts\") --no-error-on-unmatched-pattern",
    "lint:fix": "npx eslint . --fix",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit:watch -- run",
    "test:unit:report": "npx vite preview --outDir vitest/unit",
    "test:unit:watch": "vitest --outputFile=./vitest/unit/index.html"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^2.1.1",
    "happy-dom": "^15.7.4",
    "vitest": "^2.1.1",
    "vue": "^3.4.37"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/ui": "^2.1.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.28.0",
    "reka-ui": "^2.3.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.7.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.2.2",
    "vue-tsc": "^2.0.29"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/lib/components.js",
      "require": "./dist/lib/components.cjs"
    },
    "./composables": {
      "types": "./dist/types/composables.d.ts",
      "import": "./dist/lib/composables.js",
      "require": "./dist/lib/composables.cjs"
    },
    "./directives": {
      "types": "./dist/types/directives.d.ts",
      "import": "./dist/lib/directives.js",
      "require": "./dist/lib/directives.cjs"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "require": "./dist/lib/utils.cjs"
    }
  },
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "workspaces": [
    "playground"
  ]
}
